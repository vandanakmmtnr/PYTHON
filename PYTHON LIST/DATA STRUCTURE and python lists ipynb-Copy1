   "source": [
    "**Using Step Value**\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "138209e8-04c8-4eac-ad4a-f7b1a06433f7",
   "metadata": {},
   "outputs": [
